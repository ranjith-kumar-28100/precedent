# =====================================================================================
# Precedent configuration. Everything is Azure AI Foundry (Azure OpenAI v1 endpoint).
# Replace <resource> with your Azure OpenAI resource name. Keep this file out of git.
# =====================================================================================

# ---- 1. The negotiation AGENT (what judges see): deployment of gpt-4.1 ----------------
LLM_MODEL=                      # your gpt-4.1 DEPLOYMENT NAME
LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1
LLM_API_KEY=                    # Azure key

# ---- 2. Hindsight server's background work (extraction, consolidation): gpt-4.1-mini --
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=        # your gpt-4.1-mini DEPLOYMENT NAME
HINDSIGHT_API_LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1
HINDSIGHT_API_LLM_API_KEY=      # Azure key (same resource key works for both)
HINDSIGHT_API_LLM_TIMEOUT=120
HINDSIGHT_API_LLM_MAX_CONCURRENT=8
HINDSIGHT_API_LLM_MAX_RETRIES=6

# ---- Hindsight (open-source server: ./run_hindsight.sh) ---------------------------------
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_BANK_ID=precedent-procurement

# ---- Spend guards ----
AGENT_BUDGET_USD=3.0            # the API refuses agent calls beyond this estimated spend per process
# AGENT_PRICE_IN_PER_M=2.0      # gpt-4.1 list price per million input tokens (adjust to your region)
# AGENT_PRICE_OUT_PER_M=8.0
# ALLOW_FRESH_EVAL=1            # enables a paid, fresh learning-curve run; leave unset for the demo
